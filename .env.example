# URL base del backend IoT (sin camino final)
BACKEND_BASE_URL=https://back-example-ocx9.onrender.com

# Ruta del endpoint que recibe los promedios del Edge
BACKEND_AVERAGES_PATH=/api/v1/telemetry/averages

# API key opcional si el backend requiere autenticación (no subir este archivo con valores reales)
BACKEND_API_KEY=

# Timeout en segundos para peticiones al backend
BACKEND_TIMEOUT=5.0
